# The web app and its API on one origin (docs/runbook.md). TLS terminates in
# front of this in production; locally it is plain http on :8080.
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		# Join links and reset links carry their token in the URL: never leak it.
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		# The demo classroom uses no devices.
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Everything is same-origin. The hashes allow exactly these inline blocks, nothing else:
		#   script-src: the theme script in apps/web/index.html (applied before first paint),
		#               hash kept in apps/web/csp.json;
		#   style-src:  the <style> Sonner (toasts) injects at load and the one NumberFlow adds
		#               to its shadow root, plus the empty-string hash: Sonner inserts its
		#               <style> empty before filling it, and browsers check it on insertion.
		#               React style props go through the CSSOM, which CSP does not restrict,
		#               so no 'unsafe-inline' is needed.
		#   font-src:   data: for the small font subsets Vite inlines into the CSS.
		# apps/web/scripts/csp.spec.ts recomputes the hashes from the sources and fails when one
		# changes (edited script, upgraded library): update the header in the same change.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-pVq1QjxKDLmB6Oun4OYWmXQ0OYsh2GBLINupbCXujfs='; style-src 'self' 'sha256-StEaX+se6YS7pqjzrzMIA0KaX9zF/8zAhvQXZAe5epY=' 'sha256-HR6/MuuYfB8aijiNP5MPm3YOR8WqVmL7UkE3Q8OslTs=' 'sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU='; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# Hashed build output: cached for good. A missing chunk is a real 404 (an old tab after a
	# deploy), never index.html, so the app's failed-import handling can offer a reload.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		# Client-side routes (/book, /bookings/..., /class/...) all load index.html.
		try_files {path} /index.html
		file_server
	}
}
