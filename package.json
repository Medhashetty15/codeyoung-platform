{
  "name": "codeyoung-trial-booking",
  "private": true,
  "description": "Codeyoung trial-class booking system",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run build:packages && concurrently --names packages,api,worker,web --prefix-colors gray,blue,magenta,green \"npm:dev:packages\" \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:packages": "tsc -b --watch --preserveWatchOutput packages/contracts/tsconfig.build.json packages/time/tsconfig.build.json",
    "dev:api": "npm run dev -w @app/api",
    "dev:worker": "npm run dev:worker -w @app/api",
    "dev:web": "npm run dev -w @app/web",
    "cli": "npm run build:packages && npm run build -w @app/api && npm run cli -w @app/api --",
    "build": "npm run build --workspaces --if-present",
    "build:packages": "tsc -b packages/contracts/tsconfig.build.json packages/time/tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:int": "npm run test:int --workspaces --if-present",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "npm run cli -- db:migrate",
    "db:revert": "npm run cli -- db:revert",
    "db:drift": "npm run cli -- db:drift",
    "db:seed": "npm run cli -- db:seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "testcontainers": "12.0.4"
  }
}
