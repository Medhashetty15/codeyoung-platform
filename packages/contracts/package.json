{
  "name": "@app/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared zod schemas, types and fixtures for the Codeyoung API",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@app/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.2",
    "vitest": "5.0.2"
  }
}
