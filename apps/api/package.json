{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "description": "Codeyoung trial booking API, worker and ops CLI",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker --path tsconfig.worker-dev.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "cli": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage"
  },
  "dependencies": {
    "@app/contracts": "*",
    "@app/time": "*",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "11.0.3",
    "argon2": "0.45.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nest-commander": "3.21.0",
    "nestjs-pino": "5.2.1",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.6",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.0.4",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.2",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
