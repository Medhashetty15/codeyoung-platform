<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light only" />
    <title>{{subject}}</title>
    <style>
      body { margin: 0; padding: 0; background: #fafafa; color: #18181b; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 1.5; }
      .wrapper { width: 100%; background: #fafafa; padding: 24px 0; }
      .card { max-width: 560px; margin: 0 auto; background: #ffffff; border: 1px solid #e4e4e7; border-radius: 12px; padding: 32px; }
      .brand { font-size: 18px; font-weight: 700; color: #166a4e; margin: 0 0 24px; }
      h1 { font-size: 22px; line-height: 1.3; margin: 0 0 16px; color: #18181b; }
      p { margin: 0 0 16px; }
      .when { background: #e7f3ee; color: #0f4e39; border-radius: 8px; padding: 12px 16px; margin: 0 0 16px; font-weight: 600; }
      .muted { color: #52525b; font-size: 14px; }
      .button { display: inline-block; background: #166a4e; color: #ffffff; text-decoration: none; font-weight: 600; border-radius: 8px; padding: 12px 20px; }
      .actions { margin: 24px 0; }
      a { color: #166a4e; }
      .footer { max-width: 560px; margin: 16px auto 0; color: #71717a; font-size: 13px; text-align: center; padding: 0 16px; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">
        <p class="brand">Codeyoung</p>
        {{{body}}}
      </div>
      <p class="footer">{{footer}}</p>
    </div>
  </body>
</html>
