# Copy to apps/api/.env for local development. Real environment variables win over this file.
# Every key is validated at boot (apps/api/src/config/app-config.ts, docs/03 §11).

# development | test | production
NODE_ENV=development
# Backend worktree API: 3000. Frontend worktree runs its own API on 3001 with codeyoung_fe.
PORT=3000
DATABASE_URL=postgres://codeyoung:codeyoung@localhost:5433/codeyoung_dev

# Web app origin: used for links in emails and as the default CORS allow-list.
WEB_BASE_URL=http://localhost:5173
# Optional comma-separated CORS allow-list; defaults to the WEB_BASE_URL origin.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs; defaults to true when NODE_ENV=development.
# LOG_PRETTY=true

# HS256 key for access tokens, at least 32 bytes. Generate one: openssl rand -base64 48
JWT_ACCESS_SECRET=local-dev-only-change-me-0123456789abcdef
# Access token lifetime in seconds.
# JWT_ACCESS_TTL_SEC=900
# Refresh token lifetime, absolute session cap, parallel-tab grace window.
# REFRESH_TTL_DAYS=7
# SESSION_MAX_DAYS=30
# REFRESH_REUSE_GRACE_SEC=20
# PASSWORD_RESET_TTL_MIN=30
# Lock login after this many failures within LOGIN_LOCK_MINUTES.
# LOGIN_LOCK_THRESHOLD=10
# LOGIN_LOCK_MINUTES=15
# Secure refresh cookie. Must be true in production; false for local http (WebKit drops Secure cookies).
COOKIE_SECURE=false

# Number of reverse-proxy hops to trust for client IPs (0 when exposed directly).
TRUST_PROXY_HOPS=0
# Scales every rate limit (e2e runs use a large value). Must be <= 1 in production.
RATE_LIMIT_MULTIPLIER=1

# Booking rules (docs/03 §11); exposed to the web app at /api/v1/meta/booking-config.
# TRIAL_DURATION_MIN=60
# SLOT_GRID_MIN=30
# MENTOR_BUFFER_MIN=15
# BOOKING_LEAD_TIME_MIN=240
# BOOKING_HORIZON_DAYS=14
# RESCHEDULE_CUTOFF_MIN=120
# DEFAULT_MAX_TRIALS_PER_DAY=2
# CLASSROOM_OPENS_MIN_BEFORE=10
# MENTOR_DISPLAY_TIMEZONE=Asia/Kolkata

# Email (docs/03 §7.4). Local default is Mailpit from docker-compose (UI http://localhost:8025).
# Required in production, e.g. smtps://user:pass@email-smtp.eu-west-1.amazonaws.com:465
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Codeyoung <trials@codeyoung.dev>

# Worker outbox relay: poll interval and attempts before a message is DEAD.
# OUTBOX_POLL_MS=2000
# OUTBOX_MAX_ATTEMPTS=8

# Password of the seeded demo parent (npm run db:seed). Default: violet-harbour-lantern
# SEED_DEMO_PASSWORD=violet-harbour-lantern
